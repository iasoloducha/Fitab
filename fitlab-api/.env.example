# ===========================================
# FITLAB API - Environment Configuration
# ===========================================
# Copy this file to .env and fill in your values

# -------------------------------------------------------
# Required in Production
# -------------------------------------------------------

# Secret key for session encryption (generate a random 32-byte hex string)
SESSION_SECRET=

# Allowed origins for CORS (comma-separated, no spaces)
# Example: https://your-domain.com,https://admin.your-domain.com
ALLOWED_ORIGINS=

# -------------------------------------------------------
# Optional - Development
# -------------------------------------------------------

# Set to "true" for local development
DEV_MODE=true

# Database path (defaults to ./fitlab.db)
DATABASE_PATH=./fitlab.db

# Server address (defaults to :8080)
ADDR=:8080

# -------------------------------------------------------
# Feature Flags
# -------------------------------------------------------

# Professor registration code (required if DEV_MODE=false and professors need to register)
# PROFESSOR_REGISTRATION_CODE=

# Admin emails (comma-separated list)
# ADMIN_EMAILS=admin@example.com,another@example.com